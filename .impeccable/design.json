  "narrative": {
    "northStar": "The Working Ledger",
    "overview": "UXLedger looks like a ledger someone actually keeps: warm paper, ruled lines, one burnt-orange pen. Surfaces are a white page and a sand ground (#f4f2ea) separated by hairline borders (#e8ddc8), and the only loud thing on any screen is the single orange (#c74504). Manrope at weight 800 with tight tracking does the shouting; everything else is quiet.\n\nDepth is nearly flat. Cards rest on a hairline plus a 1-2px ambient shadow; only overlays and product pictures genuinely lift. Components feel refined and restrained.\n\nTwo scopes share one token set: the authenticated app (14px, ink #1c1917) and the public `.marketing` surfaces (16px, ink #333333, muted #5f5a54).",
    "keyCharacteristics": [
      "Warm paper and one orange voice; status colors are small, paired and soft.",
      "Flat surfaces, hairline borders, tonal grounds (white vs sand).",
      "Manrope only. Weight 800 and negative tracking for display; 500-600 for UI.",
      "Light, dark and system themes from the same semantic tokens.",
      "Real screenshots and labelled sample data, never stock proof."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Orange is the only accent. Fills use #c74504; any orange text on a light ground uses #a93a03. Status hues never compete with it for the primary action.",
        "section": "colors"
      },
      {
        "name": "The Semantic Token Rule",
        "body": "Components use semantic tokens, never raw hex. Marketing changes values by scope, not by component forks.",
        "section": "colors"
      },
      {
        "name": "The Heavy Headline Rule",
        "body": "Weight 800 plus negative tracking belongs to display and section headings; UI chrome stays 500-600.",
        "section": "typography"
      },
      {
        "name": "The Lift Is Earned Rule",
        "body": "Only overlays and product pictures lift visibly. A card never gains a shadow bigger than raised, and only on hover when interactive.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use #c74504 for fills and #a93a03 for orange text on light grounds.",
      "Do separate surfaces with hairlines (#e8ddc8) and sand (#f4f2ea) before reaching for a shadow.",
      "Do pair every status color as text on its soft ground.",
      "Do keep sidebar active state quiet (`bg-foreground/5`).",
      "Do use `p-5 sm:p-5` when overriding CardContent padding.",
      "Do label authored previews \"Sample data\" and use real screenshots for the laptop.",
      "Do keep the 14px / 16px split between app and `.marketing`."
    ],
    "donts": [
      "Don't introduce a second accent hue or use orange for large text on white at #c74504.",
      "Don't lift ordinary cards beyond the Raised shadow, or put shadows on flat in-app chrome.",
      "Don't put a gradient or glow on type or on the hero ground.",
      "Don't invent customers, logos, stats, testimonials or prices in previews.",
      "Don't hard-code hex in components when a semantic token exists."
    ]
  }
}